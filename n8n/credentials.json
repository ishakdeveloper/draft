[
  {
    "name": "Draft worker secret",
    "type": "httpHeaderAuth",
    "data": {
      "name": "x-pipeline-secret",
      "value": "${PIPELINE_SECRET}"
    }
  },
  {
    "name": "Draft replay secret",
    "type": "httpHeaderAuth",
    "data": {
      "name": "x-replay-secret",
      "value": "${REPLAY_SECRET}"
    }
  },
  {
    "name": "Draft approval secret",
    "type": "httpHeaderAuth",
    "data": {
      "name": "x-webhook-secret",
      "value": "${APPROVAL_SECRET}"
    }
  }
]
